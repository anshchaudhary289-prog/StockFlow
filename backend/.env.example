# StockFlow backend environment — copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to git.

# Google Gemini API key (used by services/ocr_service.py to read invoices)
GEMINI_API_KEY=

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase anon/public key (Project Settings → API → anon public)
SUPABASE_ANON_KEY=

# Supabase service-role key (Project Settings → API → service_role) — keep secret
SUPABASE_SERVICE_ROLE_KEY=
