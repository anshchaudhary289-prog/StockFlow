# StockFlow frontend environment — copy this file to ".env" and fill in real values.
# These two values are the SAME Supabase URL and anon key used in the backend .env.
# NEVER commit the real .env file to git.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: backend API base URL (defaults to http://127.0.0.1:8002 if not set)
# VITE_API_BASE=http://127.0.0.1:8002
